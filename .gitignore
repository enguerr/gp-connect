# ── Build & artefacts ──────────────────────────────────────────────
# Les paquets historiques embarquent d'anciennes versions du code
# (commentaires, exemples d'hôtes, IPs internes). Ne jamais publier.
/build/
/dist/
*.deb
*.rpm
*.tar.gz
*.tar.xz
*.zip
*.dsc
*.asc

# ── OpenConnect amont (dépendance système, pas le code de ce client)
/openconnect-9.12/
/openconnect_*.tar.gz
/openconnect_*.tar.xz
/openconnect_*.dsc
/openconnect_*.asc

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env/
*.egg

# ── IDE / éditeurs ─────────────────────────────────────────────────
