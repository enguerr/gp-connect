*.pem
*.key
*.crt
*.p12
*.pfx
*.ovpn
*.conf
!*.desktop
config.json
*.token
.vpn_state.json
hip_template.xml

# ── Logs & dumps ───────────────────────────────────────────────────
*.log
*.pcap
*.pcapng
core
core.*

